---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import Sidebar from '../components/Sidebar.astro';
import SubpageTree from '../components/SubpageTree.astro';
import '../styles/nion-book.css';
import { AUTHOR } from '../site.config';

interface Props {
  title: string;
  description?: string;
  entry?: any;
  prevUrl?: string;
  prevTitle?: string;
  nextUrl?: string;
  nextTitle?: string;
}

const {
  title,
  description = 'Java-boken av Marcus Ackre Medina',
  entry,
  prevUrl,
  prevTitle,
  nextUrl,
  nextTitle,
} = Astro.props;

const siteTitle = 'Programmering i Java';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://marcusjobb.github.io');

const entryIdNorm = entry?.id?.replace(/\.mdx?$/, '').replace(/\/index$/, '').replace(/^index$/, '') ?? null;
const isHome = entryIdNorm === '';
const fullTitle = (title && !isHome) ? `${title} · ${siteTitle}` : siteTitle;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function docUrl(e: any): string {
  const id = e.id.replace(/\.mdx?$/, '').replace(/\/index$/, '').replace(/^index$/, '');
  return id ? `${base}/${id}/` : `${base}/`;
}

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://marcusjobb.github.io/').replace(/\/$/, '');

// Undersidor i högermenyn: barn i den här sidans egen mapp (bara index-sidor har några).
// Barn matchas på parent-titel. Är titeln en dubblett (t.ex. "Events" i flera avsnitt)
// kräver vi dessutom att barnet ligger i den här sidans mapp, så att de inte hamnar under varandra.
type SubNode = { entry: any; children: SubNode[] };
const isIndexId = (id: string) => /(^|\/)index\.mdx?$/.test(id);
const docsForTree = !isHome && entry && isIndexId(entry.id) ? await getCollection('docs') : [];
function subpagesOf(e: any): SubNode[] {
  const dir = e.id.replace(/\.mdx?$/, '').replace(/\/index$/, '');
  const titleIsUnique = docsForTree.filter((d: any) => d.data.title === e.data.title).length === 1;
  return docsForTree
    .filter((c: any) => c.id !== e.id && c.data.parent === e.data.title && (titleIsUnique || c.id.startsWith(`${dir}/`)))
    .sort((a: any, b: any) => (a.data.nav_order ?? 99) - (b.data.nav_order ?? 99))
    .map((c: any) => ({ entry: c, children: isIndexId(c.id) ? subpagesOf(c) : [] }));
}
const subpages: SubNode[] = docsForTree.length > 0 ? subpagesOf(entry) : [];

const breadcrumbItems: { name: string; url: string }[] = [
  { name: siteTitle, url: `${siteOrigin}${base}/` },
];
if (!isHome && entry?.data?.parent) {
  const allDocs = await getCollection('docs');
  const parentEntry = allDocs.find((e: any) => e.data.title === entry.data.parent);
  if (parentEntry) {
    breadcrumbItems.push({ name: parentEntry.data.title, url: `${siteOrigin}${docUrl(parentEntry)}` });
  }
}
if (!isHome && title) {
  breadcrumbItems.push({ name: title, url: canonicalURL.toString() });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": isHome ? "WebSite" : "TechArticle",
      "name": fullTitle,
      "headline": isHome ? undefined : title,
      "description": description,
      "url": canonicalURL.toString(),
      "inLanguage": "sv",
      "author": { "@type": "Person", "@id": "https://marcusjobb.github.io/#person", "name": AUTHOR.name, "sameAs": [AUTHOR.linkedinUrl, AUTHOR.githubUrl, "https://orcid.org/0009-0005-7717-306X"] },
      "publisher": { "@type": "Person", "@id": "https://marcusjobb.github.io/#person", "name": AUTHOR.name },
      ...(!isHome ? {
        "educationalLevel": "Yrkeshögskola",
        "teaches": ["Java", "Objektorienterad programmering", "JVM", "Samlingar", "Generics", "Spring Boot"],
        "audience": { "@type": "EducationalAudience", "educationalRole": "student", "audienceType": "Yrkeshögskolestuderande i mjukvaruutveckling" },
        "isPartOf": { "@type": "WebSite", "name": "YH-böcker av Marcus Ackre Medina", "url": "https://marcusjobb.github.io/" },
        "license": "https://creativecommons.org/licenses/by-nc/4.0/",
        "datePublished": "2024-09-01",
        "dateModified": new Date().toISOString().split('T')[0],
      } : {}),
    },
    ...(breadcrumbItems.length > 1 ? [{
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url,
      })),
    }] : []),
  ],
};
---
<!DOCTYPE html>
<html lang="sv" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>

  <link rel="canonical" href={canonicalURL}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:type" content="article">
  <meta property="og:site_name" content={siteTitle}>
  <meta property="og:locale" content="sv_SE">
  <meta property="og:image" content="https://marcusjobb.github.io/programmering-java/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content="https://marcusjobb.github.io/programmering-java/og-image.png">

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Pre-paint: hämta tema + teckenstorlek ur localStorage INNAN första render, annars blinkar sidan -->
  <script is:inline>
    // Körs vid första laddning OCH efter varje sidbyte (ClientRouter byter ut <html>-attribut)
    function applyPrefs() {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
        var fs = parseFloat(localStorage.getItem('fontSize'));
        if (fs >= 14 && fs <= 26) document.documentElement.style.fontSize = fs + 'px';
      } catch(e) {}
    }
    applyPrefs();
    document.addEventListener('astro:after-swap', applyPrefs);
  </script>

  <ClientRouter />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">
</head>
<body>

<!-- Search overlay (hidden by default) -->
<div id="search-overlay" role="dialog" aria-modal="true" aria-label="Sök i boken" hidden>
  <div id="search-modal">
    <div id="search-header">
      <span>Sök i boken</span>
      <kbd>Esc</kbd>
    </div>
    <div id="pagefind-ui-container"></div>
  </div>
</div>

<div class="layout">
  <Sidebar currentPath={Astro.url.pathname} currentEntry={entry} />

  <main class="main" id="main-content">
    {isHome && (
      <section class="hero">
        <span class="hero-badge">Java · Spring Boot · NionIT</span>
        <h1 class="hero-title">Java-boken</h1>
        <p class="hero-sub">Java-programmering för YH-studerande av Marcus Ackre Medina — från grunderna till Spring Boot och API-utveckling.</p>
        <div class="hero-actions">
          {nextUrl && <a href={nextUrl} class="btn-primary">Börja läsa →</a>}
          <a href={`${base}/ordlista/`} class="btn-secondary">Ordlista</a>
        </div>
        <div class="hero-stats">
          <span>Gratis</span>
          <span>·</span>
          <span>På svenska</span>
          <span>·</span>
          <span>Uppdaterad 2026</span>
        </div>
      </section>
    )}
    <div class="prose">
      <slot />
    </div>
    {!isHome && (
      <p class="byline">
        Skriven av <a href={AUTHOR.linkedinUrl} target="_blank" rel="noopener">{AUTHOR.name}</a>
        {' · '}<a href={AUTHOR.githubUrl} target="_blank" rel="noopener">GitHub</a>
        {' · '}{AUTHOR.school}
      </p>
    )}
    {(prevUrl || nextUrl) && (
      <nav class="page-nav" aria-label="Sidnavigering">
        {prevUrl ? (
          <a href={prevUrl} class="page-nav-card page-nav-prev">
            <span class="page-nav-dir">← Föregående</span>
            <span class="page-nav-title">{prevTitle}</span>
          </a>
        ) : <span />}
        {nextUrl ? (
          <a href={nextUrl} class="page-nav-card page-nav-next">
            <span class="page-nav-dir">Nästa →</span>
            <span class="page-nav-title">{nextTitle}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </main>

  <aside class="toc" aria-label="Sidans innehåll" id="toc-aside" data-has-subpages={subpages.length > 0 ? 'true' : 'false'}>
    {subpages.length > 0 && (
      <div class="subpages">
        <p class="toc-heading">Undersidor</p>
        <nav aria-label="Undersidor">
          <SubpageTree nodes={subpages} base={base} />
        </nav>
      </div>
    )}
    <div id="toc-section">
      <p class="toc-heading">På den här sidan</p>
      <nav id="toc-nav"></nav>
    </div>
  </aside>
</div>

<!-- Mermaid — laddas en gång som modul, körs om vid varje sidnavigering -->
<script>
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs';
  mermaid.initialize({ startOnLoad: false, theme: 'neutral' });

  // Expressive Code syntax-highlightar ```mermaid-block innan mermaid.js ser dem
  // (radbryter källkoden i massor av <span>, döper inte om till class="mermaid").
  // Vi plockar ut rå text rad för rad ur dess markup och renderar varje diagram
  // FÖR SIG med mermaid.render() + eget try/catch — mermaid.run() bearbetar alla
  // diagram på sidan som en batch, så ett enda diagram med syntaxfel kan stoppa
  // resten. Med individuell rendering blir ett trasigt diagram isolerat.
  let renderCounter = 0;

  async function renderMermaidDiagrams() {
    const blocks = document.querySelectorAll('pre[data-language="mermaid"]');
    for (const pre of Array.from(blocks)) {
      const lines = Array.from(pre.querySelectorAll('.ec-line')).map(l => l.textContent ?? '');
      const code = (lines.length ? lines.join('\n') : (pre.textContent ?? '')).trim();

      const container = document.createElement('div');
      container.className = 'mermaid';
      const frame = pre.closest('.expressive-code') ?? pre;
      frame.replaceWith(container);

      if (!code) continue;

      try {
        const { svg, bindFunctions } = await mermaid.render(`mermaid-diagram-${renderCounter++}`, code);
        container.innerHTML = svg;
        bindFunctions?.(container);
      } catch (err) {
        console.error('Mermaid-diagrammet gick inte att rendera:', err, code);
        container.classList.remove('mermaid');
        container.classList.add('mermaid-error');
        container.textContent = code;
      }
    }
  }

  document.addEventListener('astro:page-load', () => { renderMermaidDiagrams(); });
</script>

<!-- Search modal + TOC + bionic re-apply -->
<script>
const BIONIC_COOKIE = 'bionicReading';
const BIONIC_SKIP: Record<string, boolean> = {
  SCRIPT: true, STYLE: true, CODE: true, PRE: true, KBD: true, SAMP: true, BUTTON: true
};

function getCookie(name: string): string | null {
  for (const pair of document.cookie.split(';')) {
    const [k, v] = pair.trim().split('=');
    if (k === name) return v;
  }
  return null;
}

function bionicWord(word: string): string {
  if (word.length <= 1) return word;
  const b = Math.ceil(word.length / 2);
  return `<strong>${word.slice(0, b)}</strong>${word.slice(b)}`;
}

function applyBionic(node: Node): void {
  if (node.nodeType === 3) {
    const text = node.textContent ?? '';
    if (!text.trim()) return;
    const html = text.split(' ').map(w => {
      const m = w.match(/^([A-Za-zÀ-ɏåäöÅÄÖ]+)(.*)$/);
      if (!m || m[1].length <= 1) return w;
      return bionicWord(m[1]) + m[2];
    }).join(' ');
    const span = document.createElement('span');
    span.innerHTML = html;
    node.parentNode?.replaceChild(span, node);
  } else if (node.nodeType === 1 && !BIONIC_SKIP[(node as Element).tagName]) {
    Array.from(node.childNodes).forEach(applyBionic);
  }
}

// ── Search ──────────────────────────────────────────────────────────────────
let _pagefindLoaded = false;

async function loadPagefind(): Promise<void> {
  if (_pagefindLoaded) return;
  _pagefindLoaded = true;
  const pfBase = (import.meta.env.BASE_URL as string).replace(/\/$/, '');
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = `${pfBase}/_pagefind/pagefind-ui.css`;
  document.head.appendChild(link);
  const script = document.createElement('script');
  script.src = `${pfBase}/_pagefind/pagefind-ui.js`;
  document.head.appendChild(script);
  await new Promise<void>(resolve => {
    script.onload = () => resolve();
    script.onerror = () => resolve();
  });
  const PF = (window as any).PagefindUI;
  if (PF) {
    new PF({ element: '#pagefind-ui-container', showImages: false });
  }
}

function openSearch(): void {
  const overlay = document.getElementById('search-overlay');
  if (!overlay) return;
  overlay.hidden = false;
  loadPagefind();
  setTimeout(() => {
    const input = overlay.querySelector<HTMLInputElement>('input');
    if (input) input.focus();
  }, 50);
}

function closeSearch(): void {
  const overlay = document.getElementById('search-overlay');
  if (overlay) overlay.hidden = true;
}

document.addEventListener('keydown', (e: KeyboardEvent) => {
  if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
    e.preventDefault();
    const overlay = document.getElementById('search-overlay');
    if (overlay && !overlay.hidden) closeSearch();
    else openSearch();
  }
  if (e.key === 'Escape') closeSearch();
});

document.getElementById('search-overlay')?.addEventListener('click', (e: MouseEvent) => {
  if (e.target === e.currentTarget) closeSearch();
});

// ── Page-load: bionic, TOC, search trigger ───────────────────────────────────
document.addEventListener('astro:page-load', () => {
  // Re-bind search trigger (button lives in sidebar, which persists via transition:persist)
  document.getElementById('search-trigger')?.addEventListener('click', openSearch);

  // Återapplicera bionic på nytt innehåll om aktiv
  if (getCookie(BIONIC_COOKIE) === 'true') {
    const content = document.getElementById('main-content');
    if (content) applyBionic(content);
  }

  // Bygg TOC från h2/h3 i .prose
  const prose = document.querySelector('.prose');
  const tocNav = document.getElementById('toc-nav');
  const tocAside = document.getElementById('toc-aside') as HTMLElement | null;
  const tocSection = document.getElementById('toc-section') as HTMLElement | null;
  const hasSubpages = tocAside?.dataset.hasSubpages === 'true';
  if (tocNav) tocNav.innerHTML = '';
  if (tocAside) tocAside.hidden = false;
  if (tocSection) tocSection.hidden = false;
  if (!prose || !tocNav || !tocAside) return;

  const headings = prose.querySelectorAll('h2, h3');
  if (headings.length < 2) {
    // Rubrikerna räcker inte till en innehållsförteckning — men undersidorna ska synas ändå
    if (tocSection) tocSection.hidden = true;
    tocAside.hidden = !hasSubpages;
    return;
  }

  const ul = document.createElement('ul');
  ul.className = 'toc-list';
  headings.forEach(h => {
    const li = document.createElement('li');
    li.className = `toc-item toc-${h.tagName.toLowerCase()}`;
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.textContent = h.textContent;
    a.className = 'toc-link';
    li.appendChild(a);
    ul.appendChild(li);
  });
  tocNav.appendChild(ul);

  const links = tocNav.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const headingMap = new Map<string, HTMLAnchorElement>();
  links.forEach(a => {
    const href = a.getAttribute('href');
    if (href) headingMap.set(href.slice(1), a);
  });

  let activeLink: HTMLAnchorElement | null = null;
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      const link = headingMap.get(entry.target.id);
      if (!link) return;
      if (entry.isIntersecting) {
        activeLink?.classList.remove('active');
        activeLink = link;
        activeLink.classList.add('active');
      }
    });
  }, { rootMargin: '0px 0px -70% 0px', threshold: 0 });

  headings.forEach(h => observer.observe(h));
});
</script>
</body>
</html>
